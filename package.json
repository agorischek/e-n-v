{
  "name": "@e-n-v/repo",
  "version": "0.0.1",
  "packageManager": "bun@1.3.10",
  "license": "MIT",
  "module": "index.ts",
  "type": "module",
  "keywords": [
    "environment"
  ],
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@dotenvx/dotenvx": "^2.23.0",
    "@standard-schema/spec": "^1.1.0",
    "@stryker-mutator/core": "^10.0.0",
    "@types/bun": "latest",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "check-1-2": "^0.0.8",
    "commander": "^14.0.2",
    "joi": "^18.2.5",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "superstruct": "^2.0.2",
    "ts-node": "^10.9.2",
    "tsdown": "^0.22.14",
    "tsup": "^8.5.1",
    "typescript": "^7",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "scripts": {
    "build": "tsgo",
    "bundle": "bun run check:bundle && bun run --filter @e-n-v/env bundle",
    "check": "checks",
    "check:bundle": "bun scripts/check-bundle/run.ts",
    "check:format": "prettier --check .",
    "check:types": "tsgo",
    "demo": "bun run ./demo/demo.ts",
    "format": "prettier --write .",
    "lint": "oxlint",
    "prepublishOnly": "bun run check && bun run bundle",
    "test": "bun test"
  },
  "checks": {
    "runner": "bun",
    "scripts": [
      "test",
      "check:format",
      "check:types",
      "check:bundle",
      "lint"
    ]
  },
  "dependencies": {
    "bun-types": "^1.3.0"
  }
}
